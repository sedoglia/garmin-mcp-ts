{
  "manifest_version": "0.2",
  "name": "garmin-mcp-ts",
  "display_name": "Garmin Connect",
  "version": "4.3.1",
  "description": "Garmin Connect MCP Server in TypeScript with Secure Encryption",
  "author": {
    "name": "sedoglia",
    "email": "sedoglia@gmail.com",
    "url": "https://github.com/sedoglia"
  },
  "homepage": "https://github.com/sedoglia/garmin-mcp-ts",
  "documentation": "https://github.com/sedoglia/garmin-mcp-ts/blob/main/README_EN.md",
  "support": "https://github.com/sedoglia/garmin-mcp-ts/issues",
  "icon": "GARMIN.png",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/dist/index.js"
      ],
      "env": {
        "GARMIN_EMAIL": "${user_config.garmin_email}",
        "GARMIN_PASSWORD": "${user_config.garmin_password}"
      }
    }
  },
  "user_config": {
    "garmin_email": {
      "type": "string",
      "title": "Garmin Email",
      "description": "The email address of your Garmin Connect account.",
      "required": true
    },
    "garmin_password": {
      "type": "string",
      "title": "Garmin Password",
      "description": "The password of your Garmin Connect account. Stored in the operating system keychain, never in a plain text file.",
      "sensitive": true,
      "required": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sedoglia/garmin-mcp-ts"
  }
}
