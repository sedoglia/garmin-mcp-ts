# Files excluded from the packed .mcpb bundle.
#
# mcpb pack archives the working directory, so anything present on disk
# ships to users even when git ignores it. .git/, .env and lockfiles are
# already excluded by default; everything below is not.

# Claude Code local settings. Permission rules record literal command
# lines, which is how a plaintext credential reached the v4.1.0 bundle.
.claude/

# Previously packed bundles: without this, each release nests the last one.
releases/

# CI configuration: the default exclusions cover .git/ but not .github/.
.github/

# keytar's own binary is built for whoever ran npm install, so in a bundle it
# is the packing machine's and loads nowhere else. vendor/keytar carries one
# per platform instead, and secure-storage.ts picks from there.
node_modules/keytar/build/

# Defence in depth for the credential files this project can produce.
.env.*
config.json
oauth1_token.json
oauth2_token.json

# A bundle left at the root by an earlier pack. scripts/pack.mjs stages the
# tree elsewhere and never copies these, but a bare `mcpb pack .` would nest
# the previous release inside the next one.
*.mcpb
*.mcpb.sha256
