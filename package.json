{
  "name": "garmin-mcp-ts",
  "version": "4.3.3",
  "type": "module",
  "description": "Garmin Connect MCP Server in TypeScript with Secure Encryption",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "sync:manifest": "npx tsx scripts/sync-manifest.ts",
    "check:manifest": "npx tsx scripts/sync-manifest.ts --check",
    "fetch:keytar": "node scripts/fetch-keytar-prebuilds.mjs",
    "validate:manifest": "mcpb validate manifest.json",
    "pack": "npm run build && npm run check:manifest && npm run validate:manifest && npm run fetch:keytar && mcpb pack . garmin-mcp-ts.mcpb",
    "start": "node dist/index.js",
    "login": "node dist/garmin/simple-login.js",
    "dev": "tsx watch src/index.ts",
    "test": "npx tsx src/test-tools.ts",
    "test-oauth": "npx tsx src/test-oauth.ts",
    "test-keytar": "npx tsx scripts/test-keytar.ts",
    "setup-encryption": "npx tsx scripts/setup-encryption.ts",
    "check-encryption": "npx tsx scripts/check-encryption.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "garmin-connect": "^1.6.2"
  },
  "overrides": {
    "ajv": ">=8.18.0",
    "hono": ">=4.12.25",
    "@hono/node-server": ">=2.0.5",
    "lodash": ">=4.18.1",
    "path-to-regexp": ">=8.4.2",
    "fast-uri": ">=4.1.2",
    "ip-address": ">=10.1.1",
    "follow-redirects": ">=1.16.0",
    "form-data": ">=4.0.6",
    "body-parser": ">=2.3.0"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
